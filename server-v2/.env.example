# Скопируйте в .env и заполните. Каждая раскомментированная переменная отсюда
# читается и проверяется в src/config/config.js на старте — процесс отказывается
# подниматься на плохих значениях.
#
# Закомментированные переменные уже спроектированы, но схема конфига их пока
# не знает. У каждой указан этап, который её вводит: раскомментировать нужно
# одновременно здесь и в src/config/config.js.

# development | test | production
NODE_ENV=development

# Должен оставаться 3000, пока существующий клиент не переписан: базовый URL
# захардкожен как http://localhost:3000 примерно в 13 местах client/src.
PORT=3000

# fatal | error | warn | info | debug | trace
# В проде ставьте info: это отключает SQL-строки уровня debug.
LOG_LEVEL=debug


# --- этап 4 (Postgres + Database) ---
# Локальный Postgres (нативная установка в WSL, один инстанс, две базы).
# DATABASE_URL=postgres://spending:spending@localhost:5432/spending_dev
# Используется в npm test и db:migrate:test.
# TEST_DATABASE_URL=postgres://spending:spending@localhost:5432/spending_test

# --- этап 4 (CORS) ---
# Webpack dev server, на котором запускается клиент.
# CORS_ORIGIN=http://localhost:9000

# --- этап 11 (сервис паролей) ---
# Cost factor для bcrypt. Минимум 10.
# BCRYPT_COST=12

# --- этап 13 (минимальная аутентификация) ---
# Отдельные секреты для access и refresh токенов. Минимум 32 символа,
# и они обязаны различаться.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_ACCESS_SECRET=change-me-to-32-plus-random-characters
# JWT_REFRESH_SECRET=change-me-too-and-make-it-different
#
# Времена жизни токенов. Формат: <число><s|m|h|d>
# ACCESS_TTL=15m
# REFRESH_TTL=1d
# REFRESH_TTL_REMEMBER=30d

# --- этап 19 (фильтры периода) ---
# Таймзона, относительно которой считаются today/week/month/year.
# APP_TZ=Asia/Almaty
