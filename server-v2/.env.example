# Скопируйте в .env и заполните. NODE_ENV, PORT, LOG_LEVEL и DATABASE_URL читаются
# сервером и проверяются в src/config/config.ts на старте. POSTGRES_* читает
# compose.yaml. Сам файл подхватывают npm-скрипты start и dev через
# --env-file-if-exists=.env.
#
# Закомментированные переменные уже спроектированы, но схема конфига их пока
# не знает. У каждой указан этап, который её вводит: раскомментировать нужно
# одновременно здесь и в src/config/config.ts.

# development | test | production
NODE_ENV=development

PORT=3000

# fatal | error | warn | info | debug | trace
# Управляет логами приложения. SQL-логи настраиваются отдельно для PostgreSQL.
LOG_LEVEL=debug


# --- Docker Compose (Postgres) ---
# Локальный Postgres в Docker Desktop. Инициализирует обе базы при создании
# volume; приложение из WSL подключается через localhost.
POSTGRES_DB=spending_dev
POSTGRES_TEST_DB=spending_test
POSTGRES_USER=spending
POSTGRES_PASSWORD=spending
POSTGRES_PORT=5432

# -1 — выключить SQL-логи;
# 0 — логировать все запросы;
# 100 — от 100 мс.
# После изменения пересоздайте контейнер
POSTGRES_LOG_MIN_DURATION_MS=-1

# --- Подключение приложения к Postgres ---
DATABASE_URL=postgres://spending:spending@localhost:5432/spending_dev

# --- этапы 6–7 (миграции и изоляция тестов) ---
# В схеме конфига этой переменной нет: приложение читает только
# DATABASE_URL. Скрипт db:migrate:test передаёт node-pg-migrate имя этой
# переменной, а интеграционные тесты читают её напрямую.
TEST_DATABASE_URL=postgres://spending:spending@localhost:5432/spending_test

# --- этап 12а (CORS) ---
# Webpack dev server, на котором запускается клиент.
# CORS_ORIGIN=http://localhost:9000

# --- этап 11 (сервис паролей) ---
# Cost factor для bcrypt. Минимум 10.
# BCRYPT_COST=12

# --- этап 13 (минимальная аутентификация) ---
# Отдельные секреты для access и refresh токенов. Минимум 32 символа,
# и они обязаны различаться.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_ACCESS_SECRET=change-me-to-32-plus-random-characters
# JWT_REFRESH_SECRET=change-me-too-and-make-it-different
#
# Времена жизни токенов. Формат: <число><s|m|h|d>
# ACCESS_TTL=15m
# REFRESH_TTL=1d
# REFRESH_TTL_REMEMBER=30d

# --- этап 19 (фильтры периода) ---
# Таймзона, относительно которой считаются today/week/month/year.
# APP_TZ=Asia/Almaty
