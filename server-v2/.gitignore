# Здесь лежат настоящие секреты, коммитить нельзя.
# В git хранится только шаблон .env.example — копируйте его: cp .env.example .env
.env
.env.local
.env.*.local

# Сам шаблон остаётся под контролем версий.
!.env.example

# Вывод тестов и покрытия
coverage/
*.log

# Одноразовые скрипты для ручных проверок по ходу этапов.
# Живут вне src/ и test/, поэтому не попадают ни в tsc, ни в прогон тестов.
scratch/
